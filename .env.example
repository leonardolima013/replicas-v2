# ============================================================================
# BANCO DE DADOS DE METADADOS (Container Docker)
# ============================================================================
# Configurações do PostgreSQL usado para metadados dos projetos de validação
METADADOS_DB_USER=pgroot
METADADOS_DB_PASSWORD=pg@root
METADADOS_DB_NAME=replicas_metadados_db
METADADOS_DB_PORT=5434

# Configurações internas (não alterar)
DB_HOST=db_metadados
DB_PORT=5432
POSTGRES_USER=pgroot
POSTGRES_PASSWORD=pg@root
POSTGRES_DB=replicas_metadados_db

# ============================================================================
# BANCO DE DADOS DE PRODUÇÃO (Publicação de Dados Validados)
# ============================================================================
# Configure para o banco PostgreSQL onde os dados validados serão publicados
# Use 'host.docker.internal' para acessar banco na máquina host (recomendado)
# Use IP direto ou hostname para bancos externos
PROD_DB_HOST=host.docker.internal
PROD_DB_PORT=5432
PROD_DB_NAME=hubbi_prod
PROD_DB_USER=postgres
PROD_DB_PASSWORD=postgres

# ============================================================================
# REDIS (Cache e Message Broker)
# ============================================================================
REDIS_PORT=6380

# ============================================================================
# APLICAÇÃO
# ============================================================================
APP_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

# ============================================================================
# PROCESSAMENTO
# ============================================================================
# Número de processos simultâneos para Celery
MAX_CONCURRENT_PROCESSING=1

# Caminho do arquivo de dados para importação (dentro do container)
# Coloque seus arquivos .xlsx na pasta ./data/ e eles estarão em /app/data/
DATA_FILE_PATH=/app/data/input.xlsx

# ============================================================================
# JWT E AUTENTICAÇÃO
# ============================================================================
# ⚠️ IMPORTANTE: Mude esta chave em produção!
# Gere uma chave segura com: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=300

# ============================================================================
# AWS S3 (Upload de Imagens)
# ============================================================================
# Configure suas credenciais AWS aqui
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_BUCKET_NAME=hubbi-uploads-migrated
AWS_REGION=us-east-1

# ============================================================================
# DOCKER (Configuração Interna)
# ============================================================================
# Network usada pelos containers (não alterar)
DOCKER_NETWORK=replicas-network
